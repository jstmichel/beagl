@page "/Citizens/Index"
@using Beagl.WebApp.Pages.Citizens.ViewModels
@model Beagl.WebApp.Pages.Citizens.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Beagl.WebApp.Services.IStaticDataLocalizerService StaticDataLocalizer

@{
    ViewData["Title"] = Localizer["Citizens"];
}

<div class="container-fluid py-5">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="fw-bold">@Localizer["Citizens"]</h2>
            <div class="btn-group">
                <button type="button" class="btn btn-primary btn-lg" aria-expanded="false">@Localizer["Add Citizen"]</button>
                @* <button type="button" class="btn btn-primary btn-lg dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">@Localizer["Toggle Dropdown"]</span>
                </button> *@
                @* <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="/Animals/CreateCat">@Localizer["Create Cat"]</a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/Animals/CreateDog">@Localizer["Create Dog"]</a>
                    </li>
                </ul> *@
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <table class="table table-hover table-bordered align-middle bg-white rounded-4 overflow-hidden">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Phone"]</th>
                        <th>@Localizer["Cell Phone"]</th>
                        <th>@Localizer["Email"]</th>
                        <th>@Localizer["Animal Count"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DataModel != null && Model.DataModel.Any())
                    {
                        foreach (ListCitizensViewModel citizen in Model.DataModel)
                        {
                            <tr>
                                <td>@citizen.Name</td>
                                <td>@citizen.Phone</td>
                                <td>@citizen.CellPhone</td>
                                <td>@citizen.Email</td>
                                <td>@citizen.AnimalsCount</td>
                                <td>
                                    <a asp-page="Edit" asp-route-id="@citizen.Id" class="btn btn-sm btn-outline-primary me-2">@Localizer["Edit"]</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@citizen.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">@Localizer["No citizens found."]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
