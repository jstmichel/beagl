@page "/Citizens/Index"
@using Beagl.Domain.CitizenManagement.Entities
@using Beagl.WebApp.Constants
@using Beagl.WebApp.Pages.Citizens.ViewModels
@using Beagl.WebApp.Pages.Shared
@using Microsoft.AspNetCore.Authorization
@model Beagl.WebApp.Pages.Citizens.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Beagl.WebApp.Services.IStaticDataLocalizerService StaticDataLocalizer
@inject IAuthorizationService AuthorizationService


@{
    ViewData["Title"] = Localizer["Citizens"];

    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, Policies.Citizens.CanCreate)).Succeeded;
    bool canEdit = (await AuthorizationService.AuthorizeAsync(User, Policies.Citizens.CanEdit)).Succeeded;
    bool canDelete = (await AuthorizationService.AuthorizeAsync(User, Policies.Citizens.CanDelete)).Succeeded;
    bool hasActions = canEdit || canDelete;
}

<div class="container-fluid py-5">
    @await Html.PartialAsync("~/Pages/Shared/_ValidationSummary.cshtml")
    @await Html.PartialAsync("~/Pages/Shared/_HeaderWithActions.cshtml", new Beagl.WebApp.Pages.Shared.HeaderWithActionsModel {
        Title = Localizer["Citizens"].Value,
        FilterButtonText = Localizer["Filters"].Value,
        CreateAction = new ButtonAction {
            Text = Localizer["Add Citizen"].Value,
            Link = Redirection.ToCreateCitizen,
            IsShown = canCreate
        }
    })

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterPanel" aria-labelledby="filterPanelLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="filterPanelLabel">@Localizer["Filters"]</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get">
                <div class="mb-3">
                    <label asp-for="FilterModel.Name" class="form-label">@Localizer["Name"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.Name" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Email" class="form-label">@Localizer["Email"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.Email" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.PhoneNumber" class="form-label">@Localizer["Phone Number"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.PhoneNumber" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.StreetAddress" class="form-label">@Localizer["Street Address"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.StreetAddress" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.City" class="form-label">@Localizer["City"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.City" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.PostalCode" class="form-label">@Localizer["Postal Code"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.PostalCode" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">@Localizer["Apply Filters"]</button>
                <button type="button" class="btn btn-secondary w-100 mt-2" onclick="clearCitizenFilters(this.form);">@Localizer["Clear Filters"]</button>
            </form>
        </div>
    </div>

    @if (Model.DataModel.Count == 0)
    {
        <div class="alert alert-info text-center">@Localizer["Not found."]</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (ListCitizensViewModel citizen in Model.DataModel)
            {
                <div class="col-12 col-sm-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm user-hover">
                        <div class="card-body d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="card-title mb-1 fw-bold">@citizen.Name</h5>
                                        @if (!string.IsNullOrEmpty(citizen.Email))
                                        {
                                            <div class="text-muted small"><i class="bi bi-envelope"></i><span class="ms-1">@citizen.Email</span></div>
                                        }
                                        @if (!string.IsNullOrEmpty(citizen.Phone))
                                        {
                                            <div class="text-muted small"><i class="bi bi-telephone"></i><span class="ms-1">@citizen.Phone</span></div>
                                        }
                                        @if (!string.IsNullOrEmpty(citizen.CellPhone))
                                        {
                                            <div class="text-muted small"><i class="bi bi-phone"></i><span class="ms-1">@citizen.CellPhone</span></div>
                                        }
                                        @if (!string.IsNullOrEmpty(citizen.Address))
                                        {
                                            <div style="display: flex; align-items: flex-start;">
                                                <span class="icon-class" >
                                                    <i class="bi bi-geo-alt"></i>
                                                </span>
                                                <span class="text-muted small ms-1">
                                                    @Html.Raw(citizen.Address.Replace("\n", "<br />"))
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="badge bg-secondary">
                                    <span>@citizen.AnimalsCount @Localizer["Animals"]</span>
                                </div>
                            </div>
                            @if (hasActions)
                            {
                                <div class="btn-group btn-group-sm" role="group" aria-label="Citizen actions">
                                    @if (canEdit)
                                    {
                                        <a asp-page="Edit" title="@Localizer["Edit Page Title"]" aria-label="@Localizer["Edit Page Title"]" asp-route-id="@citizen.Id" class="btn btn-outline-secondary disabled" tabindex="-1" aria-disabled="true">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <span role="button" data-bs-toggle="modal" data-bs-target="#deleteModal" data-entity-id="@citizen.Id" data-entity-description="@citizen.Name" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]" class="btn btn-outline-secondary disabled" tabindex="-1" aria-disabled="true">
                                            <i class="bi bi-trash3"></i>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="d-flex justify-content-between align-items-center w-100 table-footer mt-1">
            <span class="fw-bold">@Model.TotalItems @Localizer["Total"]</span>
            <div class="d-flex align-items-center" style="height: 100%;">
                @await Html.PartialAsync("~/Pages/Shared/_Pagination.cshtml", new PaginationModel {
                    CurrentPage = Model.CurrentPage,
                    TotalPages = Model.TotalPages,
                    PageParameter = "pageNumber",
                    AdditionalQuery = $"&FilterModel.Name={Model.FilterModel?.Name}&FilterModel.Email={Model.FilterModel?.Email}&FilterModel.PhoneNumber={Model.FilterModel?.PhoneNumber}&FilterModel.StreetAddress={Model.FilterModel?.StreetAddress}&FilterModel.City={Model.FilterModel?.City}&FilterModel.PostalCode={Model.FilterModel?.PostalCode}"
                })
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("~/Pages/Shared/_DeleteModal.cshtml", new Beagl.WebApp.Pages.Shared.DeleteModalModel {
    PageNumber = Model.CurrentPage,
    FilterModel = Model.FilterModel,
    BodyHtml = Localizer["Deletion confirmation"].Value + " <strong id=\"deleteDescription\"></strong>?"
})

<script>
function clearCitizenFilters(form) {
    Array.from(form.querySelectorAll('input[type="text"]')).forEach(input => input.value = '');
}
</script>
