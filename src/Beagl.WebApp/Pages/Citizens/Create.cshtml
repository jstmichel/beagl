@page "/Citizens/Create"
@model Beagl.WebApp.Pages.Citizens.CreateCitizenModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Create Citizen"];
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">@Localizer["Create Citizen"]</h2>
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="alert alert-danger">
            <div class="fw-bold mb-2">@Localizer["Please fix the following errors:"]</div>
            <ul class="mb-0">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }
    <form method="post" enctype="multipart/form-data">
        <div class="accordion mb-4" id="citizenAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="citizenDetailsHeading">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#citizenDetailsCollapse" aria-expanded="true" aria-controls="citizenDetailsCollapse">
                        @Localizer["Citizen Details"]
                    </button>
                </h2>
                <div id="citizenDetailsCollapse" class="accordion-collapse collapse show" aria-labelledby="citizenDetailsHeading" data-bs-parent="#citizenAccordion">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex flex-column">
                                    <label class="form-label">@Localizer["Name"]</label>
                                    <div class="input-group mb-3">
                                        <select class="form-select" style="max-width: 140px;" asp-for="Input.Civility">
                                            <option value="">@Localizer["Civility"]</option>
                                            <option value="Mr">@Localizer["Mr."]</option>
                                            <option value="Mrs">@Localizer["Mrs."]</option>
                                            <option value="Ms">@Localizer["Ms."]</option>
                                            <option value="Mx">@Localizer["Mx."]</option>
                                            <option value="Dr">@Localizer["Dr."]</option>
                                            <option value="Prof">@Localizer["Prof."]</option>
                                        </select>
                                        <input type="text" class="form-control" aria-label="First name" placeholder="@Localizer["First Name"]" asp-for="Input.FirstName">
                                        <input type="text" class="form-control" aria-label="Last name" placeholder="@Localizer["Last Name"]" asp-for="Input.LastName">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="communicationPreferencesHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#communicationPreferencesCollapse" aria-expanded="false" aria-controls="communicationPreferencesCollapse">
                        @Localizer["Communication Preferences"]
                    </button>
                </h2>
                <div id="communicationPreferencesCollapse" class="accordion-collapse collapse" aria-labelledby="communicationPreferencesHeading" data-bs-parent="#citizenAccordion">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="Phone">@Localizer["Phone Number"]</label>
                                    <input type="tel" class="form-control" id="Phone" asp-for="Input.Phone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="CellPhone">@Localizer["Cell Phone"]</label>
                                    <input type="tel" class="form-control" id="CellPhone" asp-for="Input.CellPhone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="Email">@Localizer["Email"]</label>
                                    <input type="email" class="form-control" id="Email" asp-for="Input.Email" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="CommunicationPreference">@Localizer["Communication Preference"]</label>
                                    <select class="form-select" id="CommunicationPreference" asp-for="Input.CommunicationPreference">
                                        <option value="">@Localizer["Select Preference"]</option>
                                        <option value="Phone">@Localizer["Phone"]</option>
                                        <option value="CellPhone">@Localizer["Cell Phone"]</option>
                                        <option value="Email">@Localizer["Email"]</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="LanguagePreference">@Localizer["Language Preference"]</label>
                                    <select class="form-select" id="LanguagePreference" asp-for="Input.LanguagePreference">
                                        <option value="">@Localizer["Select Language"]</option>
                                        <option value="fr">@Localizer["French"]</option>
                                        <option value="en">@Localizer["English"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="addressHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#addressCollapse" aria-expanded="false" aria-controls="addressCollapse">
                        @Localizer["Address"]
                    </button>
                </h2>
                <div id="addressCollapse" class="accordion-collapse collapse" aria-labelledby="addressHeading" data-bs-parent="#citizenAccordion">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">@Localizer["Street Address"]</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" style="max-width: 100px;" placeholder="@Localizer["No."]" id="StreetNumber" asp-for="Input.StreetNumber" />
                                        <input type="text" class="form-control" placeholder="@Localizer["Street Name"]" id="StreetName" asp-for="Input.StreetName" />
                                        <input type="text" class="form-control" style="max-width: 120px;" placeholder="@Localizer["Apt."]" id="Appartment" asp-for="Input.Appartment" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="City">@Localizer["City"]</label>
                                    <input type="text" class="form-control" id="City" asp-for="Input.City" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label" for="Province">@Localizer["Province"]</label>
                                    <select class="form-select" id="Province" asp-for="Input.Province">
                                        <option value="QC" selected>@Localizer["Quebec"]</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="Country">@Localizer["Country"]</label>
                                    <select class="form-select" id="Country" asp-for="Input.Country">
                                        <option value="CA" selected>@Localizer["Canada"]</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label" for="PostalCode">@Localizer["Postal Code"]</label>
                                    <input type="text" class="form-control" id="PostalCode" asp-for="Input.PostalCode" maxlength="7" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="PostOfficeBox">@Localizer["PostOfficeBox"]</label>
                                    <input type="text" class="form-control" id="PostOfficeBox" asp-for="Input.PostOfficeBox" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
            <a asp-page="Index" class="btn btn-secondary ms-2">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
