@page "/Users/Edit/{id}"
@model Beagl.WebApp.Pages.Users.EditModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Edit User"];
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">@Localizer["Edit User"]</h2>
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <div class="fw-bold mb-2">@Localizer["Please fix the following errors:"]</div>
            <ul class="mb-0">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <form method="post" enctype="multipart/form-data">
        <div class="mb-4">
            <div class="card mb-3">
                <div class="card-header fw-bold">
                    @Localizer["User Details"]
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">
                                    @Localizer["Username"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.UserName" class="form-control" />
                                <span asp-validation-for="Input.UserName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">
                                    @Localizer["Email"]
                                </label>
                                <input asp-for="Input.Email" class="form-control" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">
                                    @Localizer["Phone Number"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.PhoneNumber" class="form-control" />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">
                                    @Localizer["Roles"] <span class="text-danger">*</span>
                                </label>
                                <select class="form-select selectpicker" name="Input.Roles" data-live-search="true">
                                    @{
                                        string? selectedRole = null;
                                        var availableRoles = Model.AvailableRoles;
                                        var inputRoles = Model.Input != null ? Model.Input.Roles : null;
                                        if (inputRoles != null && inputRoles.Count > 0)
                                        {
                                            selectedRole = inputRoles[0];
                                        }
                                        else if (availableRoles != null && availableRoles.Count > 0)
                                        {
                                            selectedRole = availableRoles[0].Name;
                                        }
                                    }
                                    @if (Model.AvailableRoles != null)
                                    {
                                        foreach (var role in Model.AvailableRoles)
                                        {
                                            if (role.Name == selectedRole)
                                            {
                                                <option value="@role.Name" selected>@role.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@role.Name">@role.Name</option>
                                            }
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Input.Roles" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a asp-page="Index" class="btn btn-secondary ms-2">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
