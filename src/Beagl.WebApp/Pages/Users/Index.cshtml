@page
@using Beagl.WebApp.Constants
@using Beagl.WebApp.Pages.Shared
@using Microsoft.AspNetCore.Authorization
@model Beagl.WebApp.Pages.Users.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localizer["User Management"];

    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanCreate)).Succeeded;
    bool canEdit = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanEdit)).Succeeded;
    bool canDelete = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanDelete)).Succeeded;
    bool hasActions = canEdit || canDelete;
}

<div class="container py-5">
    @await Html.PartialAsync("~/Pages/Shared/_ValidationSummary.cshtml")
    @await Html.PartialAsync("~/Pages/Shared/_HeaderWithActions.cshtml", new HeaderWithActionsModel {
        Title = Localizer["User Management"].Value,
        FilterButtonText = Localizer["Filters"].Value,
        CreateAction = new ButtonAction {
            Text = Localizer["Create New User"].Value,
            Link = LocalRedirection.CreateUser,
            IsShown = canCreate
        }
    })

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterPanel" aria-labelledby="filterPanelLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="filterPanelLabel">@Localizer["Filters"]</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get">
                <div class="mb-3">
                    <label asp-for="FilterModel.Username" class="form-label">@Localizer["Username"]</label>
                    <input type="text" asp-for="FilterModel.Username" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Email" class="form-label">@Localizer["Email"]</label>
                    <input type="text" asp-for="FilterModel.Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Phone" class="form-label">@Localizer["Phone"]</label>
                    <input type="text" asp-for="FilterModel.Phone" class="form-control" />
                </div>
                <button type="submit" class="btn btn-outline-primary w-100">@Localizer["Apply Filters"]</button>
            </form>
        </div>
    </div>

    @if (Model.DataModel.Count == 0)
    {
        <div class="alert alert-info text-center">@Localizer["Not found."]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm table-bordered align-middle bg-white">
                <colgroup>
                    <col style="width: 20%;">
                    <col style="width: 20%;">
                    <col style="width: 15%;">
                    <col class="width: 15%;">
                    <col class="width: 30%;">
                    if (hasActions)
                    {
                        <col class="tight">
                    }
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th class="fw-bold">@Localizer["Username Header"]</th>
                        <th class="fw-bold">@Localizer["Email Header"]</th>
                        <th class="fw-bold">@Localizer["Lockout Date Header"]</th>
                        <th class="fw-bold">@Localizer["Roles Header"]</th>
                        <th class="fw-bold">@Localizer["Status Header"]</th>
                        @if (hasActions)
                        {
                            <th class="fw-bold" aria-label="Actions">@Localizer["Actions Header"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.DataModel)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@(user.LockoutEnd?.ToString("yyyy-MM-dd HH:mm") ?? string.Empty)</td>
                        <td>
                            @if (user.Roles != null && user.Roles.Count > 0)
                            {
                                foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            }
                        </td>
                        <td>
                            @if (!user.EmailConfirmed)
                            {
                                <span class="badge bg-danger me-1">@Localizer["Unconfirmed"]</span>
                            }
                            @if (user.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">2FA</span>
                            }
                        </td>
                        @if (hasActions)
                        {
                            <td>
                                @if (canEdit)
                                {
                                        <a asp-page="Edit" title="@Localizer["Edit Page Title"]" aria-label="@Localizer["Edit Page Title"]" asp-route-id="@user.Id" class="text-decoration-none p-1">
                                            <i class="bi bi-pencil-square fs-6 btn-darker-text"></i>
                                        </a>
                                }
                                @if (canDelete)
                                {
                                    <span role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#deleteModal" data-entity-id="@user.Id" data-entity-description="@user.UserName" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]" style="cursor:pointer;" class="p-1">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </span>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
            <div class="d-flex justify-content-between align-items-center w-100 table-footer mt-1">
                <span class="fw-bold">@Model.TotalItems @Localizer["Total"]</span>
                <div class="d-flex align-items-center" style="height: 100%;">
                    @await Html.PartialAsync("~/Pages/Shared/_Pagination.cshtml", new PaginationModel {
                        CurrentPage = Model.CurrentPage,
                        TotalPages = Model.TotalPages,
                        PageParameter = "pageNumber",
                        AdditionalQuery = $"&FilterModel.Username={Model.FilterModel?.Username}&FilterModel.Email={Model.FilterModel?.Email}&FilterModel.Phone={Model.FilterModel?.Phone}"
                    })
                </div>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("~/Pages/Shared/_DeleteModal.cshtml", new Beagl.WebApp.Pages.Shared.DeleteModalModel {
    PageNumber = Model.CurrentPage,
    FilterModel = Model.FilterModel,
    BodyHtml = Localizer["Deletion confirmation"].Value + " <strong id=\"deleteDescription\"></strong>?"
})
