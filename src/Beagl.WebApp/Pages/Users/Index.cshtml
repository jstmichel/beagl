@page
@using Beagl.WebApp.Constants
@using Beagl.WebApp.Pages.Shared
@using Microsoft.AspNetCore.Authorization
@model Beagl.WebApp.Pages.Users.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localizer["User Management"];

    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanCreate)).Succeeded;
    bool canEdit = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanEdit)).Succeeded;
    bool canDelete = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanDelete)).Succeeded;
    bool hasActions = canEdit || canDelete;
}

<div class="container py-5">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <ul class="mb-0">
            @foreach (var entry in ViewData.ModelState)
            {
                foreach (var error in entry.Value.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">@Localizer["User Management"]</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterPanel" aria-controls="filterPanel">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path d="M6 10.117V14a1 1 0 0 0 2 0v-3.883l3.447-2.276A1 1 0 0 0 12.447 7H3.553a1 1 0 0 0-.553 1.841L6 10.117z"/>
                </svg>
                @Localizer["Filters"]
            </button>
            @if (canCreate)
            {
                <a asp-page="/Users/Create" class="btn btn-success btn-lg" title="@Localizer["Create New User"]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5V7.5H11.5a.5.5 0 0 1 0 1H8.5V11.5a.5.5 0 0 1-1 0V8.5H4.5a.5.5 0 0 1 0-1H7.5V4.5A.5.5 0 0 1 8 4z"/>
                    </svg>
                    @Localizer["Create New User"]
                </a>
            }
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterPanel" aria-labelledby="filterPanelLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="filterPanelLabel">@Localizer["Filters"]</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get">
                <div class="mb-3">
                    <label asp-for="FilterModel.Username" class="form-label">@Localizer["Username"]</label>
                    <input type="text" asp-for="FilterModel.Username" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Email" class="form-label">@Localizer["Email"]</label>
                    <input type="text" asp-for="FilterModel.Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Phone" class="form-label">@Localizer["Phone"]</label>
                    <input type="text" asp-for="FilterModel.Phone" class="form-control" />
                </div>
                <button type="submit" class="btn btn-outline-primary w-100">@Localizer["Apply Filters"]</button>
            </form>
        </div>
    </div>
    @if (Model.DataModel.Count == 0)
    {
        <div class="alert alert-info text-center">@Localizer["Not found."]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped table-sm align-middle bg-white rounded shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Username Header"]</th>
                        <th>@Localizer["Email Header"]</th>
                        <th>@Localizer["Lockout Date Header"]</th>
                        <th>@Localizer["Roles Header"]</th>
                        <th>@Localizer["Status Header"]</th>
                        @if (hasActions)
                        {
                            <th class="text-end actions-col" aria-label="Actions">@Localizer["Actions Header"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.DataModel)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@(user.LockoutEnd?.ToString("yyyy-MM-dd HH:mm") ?? string.Empty)</td>
                        <td>
                            @if (user.Roles != null && user.Roles.Count > 0)
                            {
                                foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            }
                        </td>
                        <td>
                            @if (!user.EmailConfirmed)
                            {
                                <span class="badge bg-danger me-1">@Localizer["Unconfirmed"]</span>
                            }
                            @if (user.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">2FA</span>
                            }
                        </td>
                        @if (hasActions)
                        {
                            <td class="text-end actions-col">
                                @if (canEdit)
                                {
                                    <a asp-page="Edit" class="btn btn-outline-primary btn-sm me-2" title="@Localizer["Edit Page Title"]" aria-label="@Localizer["Edit Page Title"]" asp-route-id="@user.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-4 1.5a.5.5 0 0 1-.65-.65l1.5-4a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 3 10.707V13h2.293l7.5-7.5z"/>
                                        </svg>
                                    </a>
                                }
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-entity-id="@user.Id" data-entity-description="@user.UserName" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5.5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6zm3 .5a.5.5 0 0 1 .5-.5.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6z"/>
                                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1H14a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                        </svg>
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="@(hasActions ? 6 : 5)">
                            <div class="d-flex justify-content-between align-items-center w-100 table-footer">
                                <span class="fw-bold">@Localizer["Total"] @Model.TotalItems</span>
                                <div class="d-flex align-items-center" style="height: 100%;">
                                    @await Html.PartialAsync("~/Pages/Shared/_Pagination.cshtml", new PaginationModel {
                                        CurrentPage = Model.CurrentPage,
                                        TotalPages = Model.TotalPages,
                                        PageParameter = "pageNumber",
                                        AdditionalQuery = $"&FilterModel.Username={Model.FilterModel?.Username}&FilterModel.Email={Model.FilterModel?.Email}&FilterModel.Phone={Model.FilterModel?.Phone}"
                                    })
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@await Html.PartialAsync("~/Pages/Shared/_DeleteModal.cshtml", new Beagl.WebApp.Pages.Shared.DeleteModalModel {
    PageNumber = Model.CurrentPage,
    FilterModel = Model.FilterModel,
    BodyHtml = Localizer["Deletion confirmation"].Value + " <strong id=\"deleteDescription\"></strong>?"
})
