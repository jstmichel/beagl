@page "/Animals/CreateDog"
@model Beagl.WebApp.Pages.Animals.CreateDogModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Create Dog"];
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">@Localizer["Create Dog"]</h2>
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="alert alert-danger">
            <div class="fw-bold mb-2">@Localizer["Please fix the following errors:"]</div>
            <ul class="mb-0">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }
    <form method="post" enctype="multipart/form-data">
        <div class="mb-4">
            <div class="card mb-3">
                <div class="card-header fw-bold">
                    @Localizer["Dog Details"]
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="mb-3 d-flex flex-column align-items-center">
                                <div id="photoPreviewContainer" class="mb-2 w-100" style="aspect-ratio: 1 / 1; background: #f8f9fa; border: 2px dashed #ced4da; border-radius: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                                    <span id="photoPlaceholder" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #adb5bd; position: absolute; top: 0; left: 0;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-upload" viewBox="0 0 16 16">
                                          <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                                          <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708z"/>
                                        </svg>
                                    </span>
                                    <img id="photoPreview" src="" alt="Photo Preview" style="width: 100%; height: 100%; object-fit: cover; display: none; position: relative; z-index: 1;" />
                                </div>
                                <input type="file" class="form-control d-none" id="photoInput" accept="image/png, image/jpeg" />
                                <input asp-for="Input.PhotoBase64" type="hidden" id="photoBase64Input" name="Input.PhotoBase64" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.OwnerCitizenId" class="form-label">@Localizer["Owner (Citizen)"]</label>
                                <select asp-for="Input.OwnerCitizenId" class="form-select">
                                    <option value="">@Localizer["Select Owner"]</option>
                                    @foreach (var citizen in Model.CitizenList)
                                    {
                                        <option value="@citizen.Id">@citizen.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Input.Name" class="form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.BirthDate" class="form-label">@Localizer["Birth Date"] <span class="text-danger">*</span></label>
                                <input asp-for="Input.BirthDate" type="date" class="form-control" min="1900-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.BreedPrimaryId" class="form-label">@Localizer["Breed"] <span class="text-danger">*</span></label>
                                <select asp-for="Input.BreedPrimaryId" class="form-select">
                                    <option value="">@Localizer["Select Breed"]</option>
                                    @foreach (var breed in Model.BreedList)
                                    {
                                        <option value="@breed.Id">@breed.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.Medal" class="form-label">@Localizer["Medal"] <span class="text-danger">*</span></label>
                                <input asp-for="Input.Medal" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Input.Gender" class="form-label">@Localizer["Gender"]</label>
                                <select asp-for="Input.Gender" class="form-select">
                                    <option value="0">@Localizer["Unknown"]</option>
                                    <option value="1">@Localizer["Male"]</option>
                                    <option value="2">@Localizer["Female"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.ColorId" class="form-label">@Localizer["Color"] <span class="text-danger">*</span></label>
                                <select asp-for="Input.ColorId" class="form-select">
                                    <option value="">@Localizer["Select Color"]</option>
                                    @foreach (var color in Model.ColorList)
                                    {
                                        <option value="@color.Id">@color.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.BreedSecondaryId" class="form-label">@Localizer["Breed Secondary"]</label>
                                <select asp-for="Input.BreedSecondaryId" class="form-select">
                                    <option value="">@Localizer["Select Secondary Breed if any"]</option>
                                    @foreach (var breed in Model.BreedList)
                                    {
                                        <option value="@breed.Id">@breed.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header fw-bold">
                    @Localizer["Health Record"]
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Input.MicrochipNumber" class="form-label">@Localizer["Microchip Number"]</label>
                                <input asp-for="Input.MicrochipNumber" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.IsSterilized" class="form-label">@Localizer["Is Sterilized"]</label>
                                <select asp-for="Input.IsSterilized" class="form-select">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Input.IsRabiesVaccinated" class="form-label">@Localizer["Is Rabies Vaccinated"]</label>
                                <select asp-for="Input.IsRabiesVaccinated" class="form-select" id="isRabiesVaccinatedSelect">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                            <div class="mb-3" id="rabiesVaccinationDateGroup">
                                <label asp-for="Input.RabiesVaccinationDate" class="form-label">@Localizer["Rabies Vaccination Date"]</label>
                                <input asp-for="Input.RabiesVaccinationDate" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Input.Weight" class="form-label">@Localizer["Weight"]</label>
                                <div class="input-group">
                                    <input asp-for="Input.Weight" class="form-control" />
                                    <select asp-for="Input.WeightUnit" class="form-select" style="max-width: 100px;">
                                        <option value="1">@Localizer["lbs"]</option>
                                        <option value="0">@Localizer["kg"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header fw-bold">
                    @Localizer["Additional Information"]
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Input.IsAnAssistanceDog" class="form-label">@Localizer["Is Assistance Dog"]</label>
                                <select asp-for="Input.IsAnAssistanceDog" class="form-select">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.IsDangerousDog" class="form-label">@Localizer["Is Dangerous Dog"]</label>
                                <select asp-for="Input.IsDangerousDog" class="form-select">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.HasResponsibilityInsurance" class="form-label">@Localizer["Has Responsibility Insurance"]</label>
                                <select asp-for="Input.HasResponsibilityInsurance" class="form-select">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.DangerousDogComment" class="form-label">@Localizer["Dangerous Dog Comment"]</label>
                                <input asp-for="Input.DangerousDogComment" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Input.ComesFromAnotherCity" class="form-label">@Localizer["Comes From Another City"]</label>
                                <select asp-for="Input.ComesFromAnotherCity" class="form-select">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.OriginCityName" class="form-label">@Localizer["Origin City Name"]</label>
                                <input asp-for="Input.OriginCityName" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.HadJudgmentInThatCity" class="form-label">@Localizer["Had Judgment In That City"]</label>
                                <select asp-for="Input.HadJudgmentInThatCity" class="form-select">
                                    <option value="false" selected>@Localizer["No"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header fw-bold">
                    @Localizer["Description"]
                </div>
                <div class="card-body">
                    <div class="row mt-2">
                        <div class="col-12">
                            <div class="mb-3">
                                <textarea asp-for="Input.Description" class="form-control" rows="7" style="min-height: 180px;"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
            <a asp-page="Index" class="btn btn-secondary ms-2">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
<!-- Photo input moved to left column -->
<script>
    var fileTooLargeMsg = '@Localizer["Image file is too large."]';
    document.addEventListener('DOMContentLoaded', function () {
        var photoInput = document.getElementById('photoInput');
        var photoPreview = document.getElementById('photoPreview');
        var photoPreviewContainer = document.getElementById('photoPreviewContainer');
        var choosePhotoBtn = document.getElementById('choosePhotoBtn');
        var base64Input = document.querySelector('input[name="Input.PhotoBase64"]');
        var placeholder = document.getElementById('photoPlaceholder');

        if (base64Input && base64Input.value) {
            photoPreview.src = 'data:image/png;base64,' + base64Input.value;
            photoPreview.style.display = 'block';
            if (placeholder) placeholder.style.display = 'none';
        }

        function triggerFileInput() {
            photoInput.click();
        }

        photoPreviewContainer.addEventListener('click', triggerFileInput);

        photoInput.addEventListener('change', function (e) {
            var file = e.target.files[0];
            var maxSize = 10 * 1024 * 1024; // 10MB
            var maxWidth = 1024;
            var maxHeight = 1024;
            var errorMsg = document.getElementById('photoErrorMsg');
            if (errorMsg) errorMsg.remove();
            if (file) {
                if (file.size > maxSize) {
                    var err = document.createElement('div');
                    err.id = 'photoErrorMsg';
                    err.className = 'text-danger mt-2';
                    err.innerText = fileTooLargeMsg;
                    photoPreviewContainer.parentNode.appendChild(err);
                    photoInput.value = '';
                    photoPreview.src = '';
                    photoPreview.style.display = 'none';
                    if (placeholder) placeholder.style.display = 'flex';
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (evt) {
                    var img = new window.Image();
                    img.onload = function () {
                        var width = img.width;
                        var height = img.height;
                        var scale = Math.min(maxWidth / width, maxHeight / height, 1);
                        var canvas = document.createElement('canvas');
                        canvas.width = Math.round(width * scale);
                        canvas.height = Math.round(height * scale);
                        var ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                        var dataUrl = canvas.toDataURL('image/png');
                        photoPreview.src = dataUrl;
                        photoPreview.style.display = 'block';
                        if (placeholder) placeholder.style.display = 'none';
                        if (base64Input) base64Input.value = dataUrl.split(',')[1];
                    };
                    img.src = evt.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                photoPreview.src = '';
                photoPreview.style.display = 'none';
                if (placeholder) placeholder.style.display = 'flex';
            }
        });
    });
</script>
