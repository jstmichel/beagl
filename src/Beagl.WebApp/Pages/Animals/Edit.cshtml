@page "/Animals/Edit/{id:guid}"
@model Beagl.WebApp.Pages.Animals.EditModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Edit Animal";
}

<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center bg-light">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <ul class="mb-0">
            @foreach (var entry in ViewData.ModelState)
            {
                foreach (var error in entry.Value.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 mx-auto">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="mb-5 text-center fw-bold">Edit Animal</h2>
                <form method="post">
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.Name" class="form-label fs-6">Name</label>
                            <input asp-for="Animal.Name" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.Name" class="text-danger"></span>
                        </div>
                        @* <div class="col-12 col-md-6">
                            <label asp-for="Animal.Species" class="form-label fs-6">Species</label>
                            <input asp-for="Animal.Species" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.Species" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.Breed" class="form-label fs-6">Breed</label>
                            <input asp-for="Animal.Breed" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.Breed" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.Color" class="form-label fs-6">Color</label>
                            <input asp-for="Animal.Color" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.Color" class="text-danger"></span>
                        </div> *@
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.Gender" class="form-label fs-6">Gender</label>
                            <input asp-for="Animal.Gender" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.Gender" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.BirthDate" class="form-label fs-6">Birth Date</label>
                            <input asp-for="Animal.BirthDate" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.BirthDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.MicrochipNumber" class="form-label fs-6">Microchip Number</label>
                            <input asp-for="Animal.MicrochipNumber" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.MicrochipNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.PermitNumber" class="form-label fs-6">Permit Number</label>
                            <input asp-for="Animal.PermitNumber" class="form-control form-control-lg" />
                            <span asp-validation-for="Animal.PermitNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.IsDangerousDog" class="form-label fs-6">Dangerous Dog</label>
                            <input asp-for="Animal.IsDangerousDog" type="checkbox" class="form-check-input" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.IsAnAssistanceDog" class="form-label fs-6">Assistance Dog</label>
                            <input asp-for="Animal.IsAnAssistanceDog" type="checkbox" class="form-check-input" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Animal.IsAnUnclawnedCat" class="form-label fs-6">Unclawned Cat</label>
                            <input asp-for="Animal.IsAnUnclawnedCat" type="checkbox" class="form-check-input" />
                        </div>
                    </div>
                    <div class="d-flex gap-3 justify-content-center mt-5">
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Save</button>
                        <a asp-page="Index" class="btn btn-outline-secondary btn-lg px-5">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
