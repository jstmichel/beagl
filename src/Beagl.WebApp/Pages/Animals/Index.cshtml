@page "/Animals/Index"
@model Beagl.WebApp.Pages.Animals.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Animals";
}

<div class="container-fluid py-5">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="fw-bold">Animals</h2>
            <a asp-page="Create" class="btn btn-primary btn-lg">Add Animal</a>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <table class="table table-hover table-bordered align-middle bg-white rounded-4 overflow-hidden">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Species</th>
                        <th>Breed</th>
                        <th>Color</th>
                        <th>Gender</th>
                        <th>Birth Date</th>
                        <th>Microchip</th>
                        <th>Permit</th>
                        <th>Dangerous</th>
                        <th>Assistance</th>
                        <th>Unclawned Cat</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Animals != null && Model.Animals.Any())
                    {
                        foreach (var animal in Model.Animals)
                        {
                            <tr>
                                <td>@animal.Name</td>
                                <td>@animal.Species</td>
                                <td>@animal.Breed</td>
                                <td>@animal.Color</td>
                                <td>@animal.Gender</td>
                                <td>@animal.BirthDate?.ToString("yyyy-MM-dd")</td>
                                <td>@animal.MicrochipNumber</td>
                                <td>@animal.PermitNumber</td>
                                <td>@(animal.IsDangerousDog ? "Yes" : "No")</td>
                                <td>@(animal.IsAnAssistanceDog ? "Yes" : "No")</td>
                                <td>@(animal.IsAnUnclawnedCat ? "Yes" : "No")</td>
                                <td>
                                    <a asp-page="Edit" asp-route-id="@animal.Id" class="btn btn-sm btn-outline-primary me-2">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@animal.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center">No animals found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
