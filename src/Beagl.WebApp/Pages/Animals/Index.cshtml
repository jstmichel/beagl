@page "/Animals/Index"
@using Beagl.Application.AnimalManagement.DTOs
@using Beagl.Domain.AnimalManagement.Enums
@using Beagl.WebApp.Constants
@using Beagl.WebApp.Pages.Animals.ViewModels
@using Beagl.WebApp.Pages.Shared
@using Microsoft.AspNetCore.Authorization
@using Npgsql.EntityFrameworkCore.PostgreSQL.Query.Internal
@model Beagl.WebApp.Pages.Animals.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Beagl.WebApp.Services.IStaticDataLocalizerService StaticDataLocalizer
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localizer["Animals"];

    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, Policies.Animals.CanCreate)).Succeeded;
    bool canEdit = (await AuthorizationService.AuthorizeAsync(User, Policies.Animals.CanEdit)).Succeeded;
    bool canDelete = (await AuthorizationService.AuthorizeAsync(User, Policies.Animals.CanDelete)).Succeeded;
    bool hasActions = canEdit || canDelete;
}

<style>
.card-img-top.square-img {
    aspect-ratio: 3 / 2;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-bottom: 1px solid #eee;
    background: #f8f9fa;
    display: block;
}
.card.animal-bg {
    position: relative;
    background-color: #fff;
    overflow: hidden;
}
.card.animal-bg .card-body,
.card.animal-bg .card-footer,
.card.animal-bg .card-img-top {
    position: relative;
    z-index: 1;
}
</style>

<div class="container-fluid py-5">
    @await Html.PartialAsync("~/Pages/Shared/_ValidationSummary.cshtml")
    @await Html.PartialAsync("~/Pages/Shared/_HeaderWithActions.cshtml", new Beagl.WebApp.Pages.Shared.HeaderWithActionsModel {
        Title = Localizer["Animals"].Value,
        FilterButtonText = Localizer["Filters"].Value,
        CreateAction = new ButtonAction {
            Text = Localizer["Add Animal"].Value,
            Link = string.Empty,
            IsShown = canCreate
        },
        SubCreateActions = new List<ButtonAction> {
            new ButtonAction {
                Text = Localizer["Create Cat"].Value,
                Link = Redirection.ToCreateCat,
                IsShown = canCreate
            },
            new ButtonAction {
                Text = Localizer["Create Dog"].Value,
                Link = Redirection.ToCreateDog,
                IsShown = canCreate
            }
        }
    })

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterPanel" aria-labelledby="filterPanelLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="filterPanelLabel">@Localizer["Filters"]</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get">
                <div class="mb-3">
                    <label asp-for="FilterModel.Name" class="form-label">@Localizer["Name"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.Name" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Species" class="form-label">@Localizer["Species"]</label>
                    <select asp-for="FilterModel.Species" class="form-select">
                        <option value="">@Localizer["All"]</option>
                        <option value="1">@StaticDataLocalizer.LocalizeSpecies(Beagl.Domain.AnimalManagement.Enums.SpeciesType.Cat)</option>
                        <option value="2">@StaticDataLocalizer.LocalizeSpecies(Beagl.Domain.AnimalManagement.Enums.SpeciesType.Dog)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.PrimaryBreed" class="form-label">@Localizer["Primary Breed"]</label>
                    <select asp-for="FilterModel.PrimaryBreed" class="form-select">
                        <option value="">@Localizer["All"]</option>
                        @foreach (var breed in Model.AllBreedList)
                        {
                            @if(Model.FilterModel.PrimaryBreed == breed.Id)
                            {
                                <option value="@breed.Id" selected>@breed.Name</option>
                            }
                            else
                            {
                                <option value="@breed.Id">@breed.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Color" class="form-label">@Localizer["Color"]</label>
                    <select asp-for="FilterModel.Color" class="form-select">
                        <option value="">@Localizer["All"]</option>
                        @foreach (var color in Model.AllColorList)
                        {
                            @if(Model.FilterModel.Color == color.Id)
                            {
                                <option value="@color.Id" selected>@color.Name</option>
                            }
                            else
                            {
                                <option value="@color.Id">@color.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.Gender" class="form-label">@Localizer["Gender"]</label>
                    <select asp-for="FilterModel.Gender" class="form-select">
                        <option value="">@Localizer["All"]</option>
                        @foreach (var gender in Enum.GetValues(typeof(Gender)).Cast<Gender>())
                        {
                            @if(Model.FilterModel.Gender == gender)
                            {
                                <option value="@gender" selected>gender.ToString()</option>
                            }
                            else
                            {
                                <option value="@gender">gender.ToString()</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.MicrochipNumber" class="form-label">@Localizer["Microchip Number"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.MicrochipNumber" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FilterModel.PermitNumber" class="form-label">@Localizer["Permit Number"]</label>
                    <div class="input-group">
                        <input type="text" asp-for="FilterModel.PermitNumber" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="this.parentElement.querySelector('input').value=''; this.parentElement.querySelector('input').focus(); event.preventDefault();" title="@Localizer["Clear"]">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">@Localizer["Apply Filters"]</button>
                <button type="button" class="btn btn-secondary w-100 mt-2" onclick="clearFilters(this.form);">@Localizer["Clear Filters"]</button>
            </form>
        </div>
    </div>

    @if (Model.DataModel.Count == 0)
    {
        <div class="alert alert-info text-center">@Localizer["Not found."]</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var animal in Model.DataModel)
            {
                <div class="col-12 col-sm-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm user-hover animal-bg">
                        @{
                            var hasImage = !string.IsNullOrEmpty(animal.Base64PngImage);
                            var imageSrc = hasImage
                                ? $"data:image/png;base64,{animal.Base64PngImage}"
                                : null;
                        }
                        <div class="position-relative">
                            @if (hasImage)
                            {
                                <img src="@imageSrc" class="card-img-top square-img" alt="@animal.Name" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center card-img-top square-img bg-light text-secondary" style="font-size: 4rem; min-height: 180px;">
                                    <i class="bi bi-image-alt"></i>
                                </div>
                            }
                            <span class="position-absolute top-0 start-0 m-2 badge bg-primary d-flex align-items-center" style="z-index:2;">
                                <i class="bi bi-award-fill"></i>
                                @if (!string.IsNullOrEmpty(animal.PermitNumber))
                                {
                                    <span class="ms-1">@animal.PermitNumber</span>
                                }
                            </span>
                            <span class="position-absolute top-0 end-0 m-2 badge bg-info d-flex align-items-center" style="z-index:2;">
                                @StaticDataLocalizer.LocalizeSpecies(animal.Species)
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between h-100 position-relative py-2 px-3">
                            <div>
                                <h5 class="card-title mb-1 fw-bold">@animal.Name</h5>
                                <div class="text-muted small"><i class="bi bi-fingerprint"></i><span class="ms-1">@animal.PrimaryBreed</span></div>
                                <div class="text-muted small"><i class="bi bi-brush"></i><span class="ms-1">@animal.Color</span></div>
                                <div class="text-muted small"><i class="bi bi-calendar-date"></i><span class="ms-1">@animal.BirthDate</span></div>
                                <div class="text-muted small"><i class="bi bi-clipboard-plus"></i><span class="ms-1">@animal.Weight @animal.WeightUnit</span></div>
                                @if (!string.IsNullOrEmpty(animal.OwnerName))
                                {
                                    <div class="text-muted small"><i class="bi bi-person"></i><span class="ms-1">@animal.OwnerName</span></div>
                                }
                                @if (!string.IsNullOrEmpty(animal.MicrochipNumber))
                                {
                                    <div class="text-muted small"><i class="bi bi-upc-scan"></i><span class="ms-1">@animal.MicrochipNumber</span></div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                @{
                                    string genderIcon = animal.Gender.ToString().ToLower() switch
                                    {
                                        "male" => "bi-gender-male",
                                        "female" => "bi-gender-female",
                                        _ => "bi-gender-ambiguous"
                                    };
                                }
                                <i class="bi @genderIcon me-2" data-bs-toggle="tooltip" title="@StaticDataLocalizer.LocalizeGender(animal.Gender)"></i>
                                @if (!string.IsNullOrEmpty(animal.DistinctiveDescription))
                                {
                                    <span class="ms-2" data-bs-toggle="tooltip" title="@animal.DistinctiveDescription">
                                        <i class="bi bi-chat-left-text"></i>
                                    </span>
                                }
                            </div>
                            @if (hasActions)
                            {
                                <div class="btn-group btn-group-sm" role="group" aria-label="User actions">
                                    @if (canEdit)
                                    {
                                        <a asp-page="Edit" title="@Localizer["Edit Page Title"]" aria-label="@Localizer["Edit Page Title"]" asp-route-id="@animal.Id" class="btn btn-outline-secondary disabled" tabindex="-1" aria-disabled="true">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <span role="button" data-bs-toggle="modal" data-bs-target="#deleteModal" data-entity-id="@animal.Id" data-entity-description="@animal.Name" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]" class="btn btn-outline-secondary disabled" tabindex="-1" aria-disabled="true">
                                            <i class="bi bi-trash3"></i>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="d-flex justify-content-between align-items-center w-100 table-footer mt-1">
            <span class="fw-bold">@Model.TotalItems @Localizer["Total"]</span>
            <div class="d-flex align-items-center" style="height: 100%;">
                @await Html.PartialAsync("~/Pages/Shared/_Pagination.cshtml", new PaginationModel {
                    CurrentPage = Model.CurrentPage,
                    TotalPages = Model.TotalPages,
                    PageParameter = "pageNumber",
                    AdditionalQuery = $"&FilterModel.Name={Model.FilterModel?.Name}&FilterModel.Species={Model.FilterModel?.Species}&FilterModel.PrimaryBreed={Model.FilterModel?.PrimaryBreed}&FilterModel.Color={Model.FilterModel?.Color}&FilterModel.Gender={Model.FilterModel?.Gender}&FilterModel.MicrochipNumber={Model.FilterModel?.MicrochipNumber}&FilterModel.PermitNumber={Model.FilterModel?.PermitNumber}"
                })
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("~/Pages/Shared/_DeleteModal.cshtml", new Beagl.WebApp.Pages.Shared.DeleteModalModel {
    PageNumber = Model.CurrentPage,
    FilterModel = Model.FilterModel,
    BodyHtml = Localizer["Deletion confirmation"].Value + " <strong id=\"deleteDescription\"></strong>?"
})

<script>
function clearFilters(form) {
    Array.from(form.querySelectorAll('input[type="text"]')).forEach(input => input.value = '');
}
</script>
