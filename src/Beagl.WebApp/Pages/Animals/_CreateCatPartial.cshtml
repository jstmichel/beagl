@model Beagl.WebApp.Pages.Animals.IndexModel.CreateCatPartialModel

<form method="post" asp-page-handler="CreateCat">
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <label asp-for="Cat.Name" class="form-label fs-6">Name</label>
            <input asp-for="Cat.Name" class="form-control form-control-lg" />
            <span asp-validation-for="Cat.Name" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Cat.BreedPrimaryId" class="form-label fs-6">Primary Breed</label>
            <select asp-for="Cat.BreedPrimaryId" class="form-select form-select-lg" asp-items="@(new SelectList(Model.BreedList, "Id", "Name"))">
                <option value="">Select primary breed...</option>
            </select>
            <span asp-validation-for="Cat.BreedPrimaryId" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Cat.ColorId" class="form-label fs-6">Color</label>
            <select asp-for="Cat.ColorId" class="form-select form-select-lg" asp-items="@(new SelectList(Model.ColorList, "Id", "Name"))">
                <option value="">Select color...</option>
            </select>
            <span asp-validation-for="Cat.ColorId" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Cat.Gender" class="form-label fs-6">Gender</label>
            <select asp-for="Cat.Gender" class="form-select form-select-lg">
                <option value="0">Unknown</option>
                <option value="1">Male</option>
                <option value="2">Female</option>
            </select>
            <span asp-validation-for="Cat.Gender" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Cat.BirthDate" class="form-label fs-6">Birth Date</label>
            <input asp-for="Cat.BirthDate" type="date" class="form-control form-control-lg" />
            <span asp-validation-for="Cat.BirthDate" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Cat.MicrochipNumber" class="form-label fs-6">Microchip Number</label>
            <input asp-for="Cat.MicrochipNumber" class="form-control form-control-lg" />
            <span asp-validation-for="Cat.MicrochipNumber" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Cat.IsAnUnclawnedCat" class="form-label fs-6">Unclawned Cat</label>
            <input asp-for="Cat.IsAnUnclawnedCat" type="checkbox" class="form-check-input" />
        </div>
        <div class="col-12">
            <label asp-for="Cat.Description" class="form-label fs-6">Description</label>
            <textarea asp-for="Cat.Description" class="form-control form-control-lg" rows="4"></textarea>
            <span asp-validation-for="Cat.Description" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-3 justify-content-center mt-5">
        <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Create</button>
        <button type="button" class="btn btn-outline-secondary btn-lg px-5" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
