@using Beagl.WebApp.Constants
@using Beagl.WebApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@inject IAuthorizationService AuthorizationService

@{
    bool canViewUsers = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanView)).Succeeded;
    bool canCreateUsers = (await AuthorizationService.AuthorizeAsync(User, Policies.Users.CanCreate)).Succeeded;
    bool canViewAnimals = (await AuthorizationService.AuthorizeAsync(User, Policies.Animals.CanView)).Succeeded;
    bool canCreateAnimals = (await AuthorizationService.AuthorizeAsync(User, Policies.Animals.CanCreate)).Succeeded;
    bool canViewCitizens = (await AuthorizationService.AuthorizeAsync(User, Policies.Citizens.CanView)).Succeeded;
    bool canCreateCitizens = (await AuthorizationService.AuthorizeAsync(User, Policies.Citizens.CanCreate)).Succeeded;

    bool hasUsersPermissions = canViewUsers || canCreateUsers;
    bool hasAnimalsPermissions = canViewAnimals || canCreateAnimals;
    bool hasCitizensPermissions = canViewCitizens || canCreateCitizens;

    bool showSideMenu = hasUsersPermissions || hasAnimalsPermissions || hasCitizensPermissions;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Beagl.WebApp.styles.css" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.petpack.min.css" />
    <link rel="stylesheet" href="css/layout-overrides.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
</head>

<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg border-bottom border-bottom-shadow" aria-label="Beagl navigation bar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/images/logo-bg-white.png" alt="Logo" height="60" />
            </a>
            <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="@L["Toggle navigation"]">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="navbar" style="">
                <ul class="navbar-nav mx-auto justify-content-center mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a asp-page="@LocalRedirection.Index" class="nav-link @(IsActive(LocalRedirection.Index))">@L["Home"]</a>
                    </li>
                </ul>
                <div class="d-flex gap-2">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form method="post" asp-page="/Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">@L["Sign Out"]</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="@LocalRedirection.Login" class="btn btn-outline-primary">@L["Sign In"]</a>
                    }
                </div>
            </div>
        </div>
    </nav>


    <div class="flex-grow-1 d-flex flex-column main-content" style="overflow-y:auto;">
        <div class="container-fluid px-2 my-4 flex-grow-1">
            <div class="row gx-3 min-vh-100 align-items-stretch">
                @if(showSideMenu)
                {
                    <div class="col-sm-12 col-md-4 col-lg-3 d-flex flex-column h-100">
                        <div class="container py-5">
                            <div class="card shadow-sm h-100 mb-2 rounded-4 bg-white">
                                <div class="card-body p-3 d-flex flex-column">
                                    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
                                        <span class="fs-4">@L["Navigation"]</span>
                                    </a>
                                    <hr />
                                    <ul class="nav nav-pills flex-column mb-auto sidebar-nav">
                                        @if (hasUsersPermissions)
                                        {
                                            <li class="mt-3 mb-1 ps-2 text-uppercase small fw-bold text-secondary" style="letter-spacing: 0.05em;">
                                                @L["Users"]
                                            </li>
                                            <li class="nav-item">
                                                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ps-0 ms-0">
                                                    @if (canViewUsers)
                                                    {
                                                        <li>
                                                            <a asp-page="@LocalRedirection.Users" class="nav-link link-body-emphasis @(IsActive(LocalRedirection.Users))">@L["User List"]</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                        @if (hasCitizensPermissions)
                                        {
                                            <li class="mt-3 mb-1 ps-2 text-uppercase small fw-bold text-secondary" style="letter-spacing: 0.05em;">
                                                @L["Citizens"]
                                            </li>
                                            <li>
                                                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ps-0 ms-0">
                                                    @if (canViewCitizens)
                                                    {
                                                        <li>
                                                            <a asp-page="@LocalRedirection.Citizens" class="nav-link link-body-emphasis @(IsActive(LocalRedirection.Citizens))">@L["Citizens List"]</a>
                                                        </li>
                                                    }
                                                    @if (canCreateCitizens)
                                                    {
                                                        <li>
                                                            <a asp-page="@LocalRedirection.AddCitizens" class="nav-link link-body-emphasis @(IsActive(LocalRedirection.AddCitizens))">@L["Add Citizen"]</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                        @if (hasAnimalsPermissions)
                                        {
                                            <li class="mt-3 mb-1 ps-2 text-uppercase small fw-bold text-secondary" style="letter-spacing: 0.05em;">
                                                @L["Animals"]
                                            </li>
                                            <li>
                                                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ps-0 ms-0">
                                                    @if (canViewAnimals)
                                                    {
                                                        <li>
                                                            <a asp-page="@LocalRedirection.Animals" class="nav-link link-body-emphasis @(IsActive(LocalRedirection.Animals))">@L["Animals List"]</a>
                                                        </li>
                                                    }
                                                    @if (canCreateAnimals)
                                                    {
                                                        <li>
                                                            <a asp-page="@LocalRedirection.CreateCat" class="nav-link link-body-emphasis @(IsActive(LocalRedirection.CreateCat))">@L["Add Cat"]</a>
                                                        </li>
                                                        <li>
                                                            <a asp-page="@LocalRedirection.CreateDog" class="nav-link link-body-emphasis @(IsActive(LocalRedirection.CreateDog))">@L["Add Dog"]</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-8 col-lg-9">
                        @RenderBody()
                    </div>
                }
                else
                {
                    <div class="col-12">
                        @RenderBody()
                    </div>
                }
            </div>
        </div>
    </div>

    <footer class="bg-light text-center py-3 mt-auto border-top">
        &copy; 2025 Beagl
    </footer>
    <script src="lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>

</html>

<style>
    .btn-toggle[aria-expanded="true"] .chevron-transition {
        transform: rotate(180deg);
        transition: transform 0.2s;
    }
    .btn-toggle[aria-expanded="false"] .chevron-transition {
        transform: rotate(0deg);
        transition: transform 0.2s;
    }
    .sidebar-nav .nav-link.active, .sidebar-nav .nav-link.active:focus, .sidebar-nav .nav-link.active:hover {
        background: #e9ecef !important;
        color: #212529 !important;
        border-radius: 0 !important;
        width: 100%;
        font-weight: 600;
    }
    .sidebar-nav .nav-link {
        border-radius: 0 !important;
        width: 100%;
    }
</style>

@functions {
    public string IsActive(string page)
    {
        var currentPage = ViewContext.ActionDescriptor is Microsoft.AspNetCore.Mvc.RazorPages.CompiledPageActionDescriptor d
            ? d.ViewEnginePath
            : "";
        return string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
