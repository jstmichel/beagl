@using Microsoft.AspNetCore.Mvc.Localization
@model Beagl.WebApp.Pages.Shared.PaginationModel
@inject IViewLocalizer L

<ul class="pagination pagination-sm mb-0 py-0 align-items-center">
    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
        <a class="page-link" href="@Url.Page(null, null, new Dictionary<string, object> { [Model.PageParameter] = Model.CurrentPage - 1 }, null)@(Model.AdditionalQuery)">@L["Previous"]</a>
    </li>
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
            <a class="page-link" href="@Url.Page(null, null, new Dictionary<string, object> { [Model.PageParameter] = i }, null)@(Model.AdditionalQuery)">@i</a>
        </li>
    }
    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
        <a class="page-link" href="@Url.Page(null, null, new Dictionary<string, object> { [Model.PageParameter] = Model.CurrentPage + 1 }, null)@(Model.AdditionalQuery)">@L["Next"]</a>
    </li>
</ul>
